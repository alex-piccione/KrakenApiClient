<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Library</OutputType>
    <UserSecretsId>Alex75.KrakenApiClient-08ccac50-5aef-4bd5-b18a-707588558352</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningsAsErrors>3239;</WarningsAsErrors>
    <NoWarn>FS0988</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alex75.Cryptocurrencies" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsUnit" />
    <PackageReference Include="CommunityToolkit.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="nunit" />
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
	  <PackageReference Update="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Client\utils.fs" />
    <Compile Include="Client\Withdraw.fs" />
    <Compile Include="Client\List Pairs.fs" />
    <Compile Include="Client\Get Ticker.fs" />
    <Compile Include="Client\Get Balance.fs" />
    <Compile Include="Client\Create Market Order.fs" />
    <Compile Include="Client\Create Limit Order.fs" />
    <Compile Include="Client\List Open Orders.fs" />
    <Compile Include="Client\List Closed Orders.fs" />
    <Compile Include="Mapping.test.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\KrakenApiClient\KrakenApiClient.fsproj" />
  </ItemGroup>
</Project>
